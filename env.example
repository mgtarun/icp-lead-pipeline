# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# Groq — LLM extraction, scoring reasons, spam/confidence checks, replies
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face Inference — sentence-transformers embeddings for RAG
HF_API_KEY=your_huggingface_api_key_here

# Supabase — pgvector knowledge base + crm_leads / messages tables
SUPABASE_KEY=your_supabase_service_key_here
SUPABASE_URL=https://your-project.supabase.co

# Twenty CRM — API key + instance host
TWENTY_API_KEY=your_twenty_api_key_here
TWENTY_HOST=https://your-twenty-host

# Your n8n instance base URL
N8N_HOST=https://your-n8n-host
